# Supabase (obligatorio para auth y datos reales en producción)
NEXT_PUBLIC_SUPABASE_URL=https://cwoigpzfkruptnapmwmh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XN5aWgNqkz5W1bp7RHJ7FQ_m3Xk_HOn

# Solo servidor — nunca en el cliente
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Web Push (VAPID) — genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joshua@ejemplo.com

# Modo demo (solo desarrollo local / preview sin Supabase remoto)
# En deploy real: LUCARE_DEMO_MODE=false y NEXT_PUBLIC_LUCARE_DEMO_MODE=false
LUCARE_DEMO_MODE=true
NEXT_PUBLIC_LUCARE_DEMO_MODE=true

# Integraciones Fase 4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/integrations/google/callback

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4321/api/integrations/notion/callback

# Notion — integración interna (solo servidor, nunca NEXT_PUBLIC_)
NOTION_TOKEN=
NOTION_DEBERES_DB_ID=

# Cifrado de tokens OAuth en Postgres (32 bytes en base64)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Cron secreto para sincronización periódica de agenda (futuro)
INTEGRATION_SYNC_SECRET=

# IA — Google Gemini directo (prioridad; solo servidor; nunca NEXT_PUBLIC_)
# Clave: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Por defecto: gemini-2.5-flash (Flash económico, verificado en @ai-sdk/google)
GEMINI_MODEL=gemini-2.5-flash

# IA — Vercel AI Gateway (respaldo si no hay clave Gemini; solo servidor)
# Lista de modelos: https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
# Por defecto: amazon/nova-micro (económico, texto)
AI_GATEWAY_MODEL=amazon/nova-micro