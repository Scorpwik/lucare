# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Modo demo (sin Supabase)
LUCARE_DEMO_MODE=true
NEXT_PUBLIC_LUCARE_DEMO_MODE=true

# Web Push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Calendar OAuth (solo servidor + redirect público)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ej. http://127.0.0.1:4321/api/integrations/google/callback
# En producción: https://tu-dominio/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Notion — integración interna (solo servidor, nunca NEXT_PUBLIC_)
NOTION_TOKEN=
NOTION_DEBERES_DB_ID=

# Cifrado de tokens OAuth en Postgres (32 bytes en base64)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Sync periódico (cron / Vercel Cron header x-sync-secret)
INTEGRATION_SYNC_SECRET=